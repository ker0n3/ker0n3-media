			<info compressed="false">https://ker0n3.github.io/ker0n3-media/addons.xml</info>
			<checksum>https://ker0n3.github.io/ker0n3-media/addons.xml.md5</checksum>
			<datadir zip="true">https://ker0n3.github.io/ker0n3-media/zips/</datadir>
			<hashes>false</hashes>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary lang="es_ES">Repositorio Ker0n3 Media: actualizaciones automáticas del skin Ker0n3 Flix.</summary>
		<summary lang="en_GB">Ker0n3 Media repository: automatic updates for the Ker0n3 Flix skin.</summary>
